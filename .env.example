# Copy this file to .env.local and fill in real values from your EmailJS
# account (emailjs.com). Never commit .env.local — it's already gitignored.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Supabase (blog + admin). Publishable key only — never the service-role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
